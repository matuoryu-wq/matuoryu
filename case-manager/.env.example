# 案件管理アプリ設定。このファイルを .env にコピーして値を設定する。
# .env は Git に含めない(.gitignore 済み)。値は画面・ログに表示されない。

# アクセストークン(必須)。32文字以上のランダム文字列。生成例:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
APP_TOKEN=

# 待受ポート(127.0.0.1 固定。外部公開は Tailscale Serve 経由のみ)
APP_PORT=8765

# データベース保存先
DATA_DIR=./data

# 日次バックアップ先(別ドライブを指定。例: D:\case-backup)
BACKUP_DIR=
# 保持する世代数
BACKUP_KEEP=30

# 案件フォルダとして紐付けを許可するルート(; 区切り)。空なら制限なし
# 例: C:\Users\me\Documents\事件;D:\事件記録
ALLOWED_FOLDER_ROOTS=

# 機微案件の再認証の有効時間(分)
REAUTH_MINUTES=10
# ログインセッションの有効期間(時間)
SESSION_HOURS=720

# v2(AI機能)で使用予定。v1では未使用
ANTHROPIC_API_KEY=
