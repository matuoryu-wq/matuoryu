# 案件管理アプリ設定。このファイルを .env にコピーして値を設定する。
# .env は Git に含めない(.gitignore 済み)。値は画面・ログに表示されない。

# アクセストークン(必須)。32文字以上のランダム文字列。生成例:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
APP_TOKEN=

# 待受ポート(127.0.0.1 固定。外部公開は Tailscale Serve 経由のみ)
APP_PORT=8765

# データベース保存先
DATA_DIR=./data

# 日次バックアップ先(別ドライブを指定。例: D:\case-backup)
BACKUP_DIR=
# 保持する世代数
BACKUP_KEEP=30

# 案件フォルダとして紐付けを許可するルート(; 区切り)。空なら制限なし
# 例: C:\Users\me\Documents\事件;D:\事件記録
ALLOWED_FOLDER_ROOTS=

# 機微案件の再認証の有効時間(分)
REAUTH_MINUTES=10
# ログインセッションの有効期間(時間)
SESSION_HOURS=720

# ---------------------------------------------------------------- v2: AI 機能
# Claude API キー(https://console.anthropic.com/ で発行)。未設定なら AI 機能は無効。
# 送信される内容は必ず匿名化され、送信ごとに監査ログ・AI送信ログに記録される。
ANTHROPIC_API_KEY=
# 使用モデルと思考の深さ(low / medium / high / xhigh / max)
AI_MODEL=claude-opus-5-5
AI_EFFORT=high

# ---------------------------------------------------------------- v2: 文字起こし(PC内で処理)
# faster-whisper のモデル(tiny / base / small / medium / large-v3、またはモデルを置いたフォルダのパス)
# 初回のみモデルをダウンロードする(音声は外部に送信されない)。CPU なら small〜medium が目安
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
# 話者分離: off / pyannote(pyannote.audio のインストールと HF_TOKEN またはローカルモデルが必要)
DIARIZATION=off
PYANNOTE_MODEL=pyannote/speaker-diarization-3.1
HF_TOKEN=

# ---------------------------------------------------------------- v2: OCR(任意)
# スキャンPDFの文字認識に Tesseract を使う場合の言語(Tesseract と jpn データのインストールが必要)
OCR_LANG=jpn
